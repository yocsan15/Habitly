{
  "expo": {
    "name": "Habit Tracker",
    "slug": "habit-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "habit-tracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habittracker.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.habittracker.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"]
  }
}
